---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

{project.takeaway && (
  <section class="project-takeaway">
    <div class="takeaway-container">
      <div class="takeaway-header gs-reveal-takeaway">
        <span class="section-label">THE TAKEAWAY</span>
      </div>
      <div class="takeaway-content gs-reveal-takeaway">
        <p class="takeaway-text">{project.takeaway}</p>
      </div>
    </div>
  </section>
)}

<style>
  .project-takeaway {
    padding: 15vh 5%;
    display: flex;
    justify-content: center;
    background: #0a0a0a;
  }

  .takeaway-container {
    max-width: 1200px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    align-items: center;
    text-align: center;
  }

  .section-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .takeaway-text {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.4;
    color: var(--color-text-primary);
    margin: 0;
    max-width: 30ch;
  }
</style>
