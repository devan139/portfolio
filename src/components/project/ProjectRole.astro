---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="project-role-technical">
  <div class="role-container">
    <div class="role-grid">
      <div class="role-column gs-reveal-tech">
        <span class="column-label">MY ROLE</span>
        <div class="column-content">
          <p class="role-title">{project.role}</p>
        </div>
      </div>
      
      {project.technologies && project.technologies.length > 0 && (
        <div class="role-column gs-reveal-tech">
          <span class="column-label">TECHNICAL SYSTEM</span>
          <div class="column-content tech-list-container">
            <ul class="tech-list">
              {project.technologies.map((tech) => (
                <li class="tech-item gs-tech-item">
                  <span class="tech-name">{tech}</span>
                  <div class="tech-line"></div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .project-role-technical {
    padding: 10vh 5%;
    display: flex;
    justify-content: center;
    background: #0d0d0d;
  }

  .role-container {
    max-width: 1200px;
    width: 100%;
  }

  .role-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 4rem;
  }

  .column-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 2rem;
  }

  .role-title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  .tech-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    text-transform: uppercase;
  }

  .tech-line {
    flex-grow: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    position: relative;
    overflow: hidden;
  }

  .tech-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-accent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .tech-item:hover .tech-line::after {
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .role-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 3rem;
    }
  }
</style>
