---
// src/components/WorkEnvironment.astro
interface Props {
  totalProjects: number;
}
const { totalProjects } = Astro.props;
---
<div class="work-environment">
  <div class="spatial-grid"></div>
  
  <div class="ui-layer">
    <div class="ui-top">
      <span class="brand">DEVANARAYANAN</span>
    </div>
    
    <div class="ui-right">
      <div class="project-indicator">
        <span class="current-index">01</span>
        <span class="separator">/</span>
        <span class="total-index">{String(totalProjects).padStart(2, '0')}</span>
      </div>
    </div>
    
    <div class="ui-bottom">
      <div class="scroll-instruction">
        SCROLL TO EXPLORE &rarr;
      </div>
    </div>
  </div>
</div>

<style>
  .work-environment {
    position: absolute;
    inset: 0;
    pointer-events: none; /* Let clicks pass through to projects */
    z-index: 10;
  }

  .spatial-grid {
    position: absolute;
    inset: 0;
    background-size: 100px 100px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    opacity: 0.5;
  }

  .ui-layer {
    position: absolute;
    inset: 0;
    padding: 2rem 5%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .ui-top, .ui-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ui-right {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .brand {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.1em;
    font-weight: 500;
    color: var(--text-color);
  }

  .project-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Space Grotesk', sans-serif;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .current-index {
    color: var(--text-color);
    font-size: 1.25rem;
  }

  .scroll-instruction {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @media (max-width: 768px) {
    .ui-right {
      display: none;
    }
    .spatial-grid {
      background-size: 50px 50px;
    }
  }
</style>
