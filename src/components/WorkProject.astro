---
// src/components/WorkProject.astro
import type { Project } from '../data/projects';
import { resolvePath } from '../utils/paths';
import { hasProjectImage } from '../utils/assets';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const isAdnoc = project.id === 'adnoc-vr';
const isSolar = project.id === 'solar-digital-twin';
const isAR = project.id === 'ar-applications';
const isBits = project.id === 'bits-pilani';
const isHero = Boolean(project.isHero);

const hasImageFile = hasProjectImage(project.image);
---

<div class={`work-project ${isHero ? 'is-hero-project' : ''}`} data-index={index + 1} data-category={project.category}>
  <div class="project-content" data-cursor="VIEW">
    
    <div class="project-info">
      <div class="project-header">
        <span class="project-number">{project.number}</span>
        {project.organization && <span class="project-org">{project.organization}</span>}
        {isHero && <span class="hero-badge">HERO PROJECT</span>}
      </div>
      
      <h3 class="project-title">{project.title}</h3>
      <p class="project-category">{project.category}</p>
      
      <div class="project-details">
        <p class="project-description">{project.description}</p>
        
        {project.role && (
          <div class="detail-group">
            <span class="detail-label">ROLE:</span> {project.role}
          </div>
        )}
        
        {project.technologies && (
          <div class="tech-list">
            {project.technologies.join(' · ')}
          </div>
        )}
        
        {project.confidentiality && (
          <p class="confidentiality-note">
            * {project.confidentiality}
          </p>
        )}
      </div>
      
      <a href={resolvePath(`/work/${project.slug}`)} class="project-link" aria-label={`Enter ${project.title} Experience`}>
        ENTER EXPERIENCE &rarr;
      </a>
    </div>

    <div class="project-visual-container">
      <div class="project-visual">
        {project.mediaType === 'video' && project.mediaSrc ? (
          <video 
            class="project-video" 
            poster={project.poster ? resolvePath(project.poster) : ''} 
            preload="none" 
            controls 
            muted 
            loop 
            playsinline>
            <source src={resolvePath(project.mediaSrc)} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        ) : hasImageFile && project.image ? (
          <img src={resolvePath(project.image)} alt={project.title} class="project-image" loading="lazy" />
        ) : (
          <div class={`abstract-visual ${isAdnoc ? 'adnoc-visual' : isSolar ? 'solar-visual' : isAR ? 'ar-visual' : isBits ? 'bits-visual' : ''}`}>
             {isAdnoc && (
               <div class="adnoc-grid">
                 <div class="scanner-line"></div>
                 {!hasImageFile && <span class="asset-dev-label">ADNOC VR TRAINING &middot; ASSET AWAITING COVER IMAGE</span>}
               </div>
             )}
             {isSolar && (
               <div class="solar-grid-scene">
                 <div class="solar-topology">
                   <div class="solar-row row-1"></div>
                   <div class="solar-row row-2"></div>
                   <div class="solar-row row-3"></div>
                   <div class="solar-array-highlight">
                     <span class="pulse-marker"></span>
                     <span class="array-id">ARRAY_04 &middot; 3D MODEL READY</span>
                   </div>
                 </div>
                 {!hasImageFile && <span class="asset-dev-label">SOLAR PLANT DIGITAL TWIN &middot; COVER SCREENSHOT PENDING</span>}
               </div>
             )}
             {isAR && (
               <div class="ar-reticle-scene">
                 <div class="ar-bounding-box">
                   <div class="corner c-tl"></div>
                   <div class="corner c-tr"></div>
                   <div class="corner c-bl"></div>
                   <div class="corner c-br"></div>
                   <div class="ar-crosshair"></div>
                   <span class="ar-status-text">SPATIAL TARGET RECOGNIZED</span>
                 </div>
               </div>
             )}
             {isBits && (
               <div class="bits-geometry">
                 <div class="shape shape-1"></div>
                 <div class="shape shape-2"></div>
               </div>
             )}
          </div>
        )}
      </div>
    </div>
    
  </div>
</div>

<style>
  .work-project {
    width: 80vw;
    height: 75vh;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
    opacity: 0.3; /* Default state for inactive projects */
    transform: scale(0.95);
  }

  .work-project.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .project-content {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: stretch;
    cursor: pointer;
  }

  /* Info Section */
  .project-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-family: 'Space Grotesk', sans-serif;
  }

  .hero-badge {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    padding: 0.2rem 0.6rem;
    background: rgba(199, 255, 74, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(199, 255, 74, 0.3);
    border-radius: 2px;
    font-weight: 600;
    margin-left: auto;
  }

  .work-project.is-hero-project.is-active .project-visual {
    box-shadow: 0 0 60px rgba(199, 255, 74, 0.08);
    border: 1px solid rgba(199, 255, 74, 0.25);
  }

  .project-number {
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .project-org {
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  .project-title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 500;
    line-height: 1.1;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .project-category {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-top: -1rem;
  }

  .project-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .project-description {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0;
  }

  .detail-group {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }
  
  .detail-label {
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
    margin-right: 0.5rem;
  }

  .tech-list {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
  }

  .confidentiality-note {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    font-style: italic;
    margin-top: 1rem;
    border-left: 2px solid rgba(255,255,255,0.1);
    padding-left: 1rem;
  }

  .project-link {
    margin-top: auto;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-text-primary);
    padding-bottom: 0.25rem;
    align-self: flex-start;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .work-project.is-active .project-link {
    opacity: 1;
    transform: translateY(0);
  }
  
  .project-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Visual Section */
  .project-visual-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-visual {
    width: 100%;
    height: 100%;
    background: #06090e;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
  }

  .project-content:hover .project-visual {
    transform: scale(0.99);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .project-video, .abstract-visual {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background-color: #06090e;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-content:hover .project-video,
  .project-content:hover .abstract-visual {
    transform: scale(1.05);
  }

  .project-content:hover .project-image {
    transform: scale(1.02);
  }

  /* Abstract Visuals */
  .abstract-visual {
    position: relative;
    background: #0a0a0a;
  }

  /* ADNOC Abstract */
  .adnoc-visual .adnoc-grid {
    position: absolute;
    inset: 0;
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .adnoc-visual .adnoc-grid::after {
    content: '';
    position: absolute;
    width: 200px;
    height: 200px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
  }

  .scanner-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(255,255,255,0.5);
    box-shadow: 0 0 10px rgba(255,255,255,0.3);
    animation: scan 4s ease-in-out infinite alternate;
  }

  @keyframes scan {
    0% { transform: translateY(0); }
    100% { transform: translateY(100vh); }
  }

  /* BITS Abstract */
  .bits-visual {
    background: #111;
  }
  
  .bits-geometry {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bits-geometry .shape {
    position: absolute;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .bits-geometry .shape-1 {
    width: 60%;
    height: 60%;
    background: linear-gradient(45deg, rgba(255,255,255,0.02), transparent);
    transform: rotate(15deg);
  }

  .bits-geometry .shape-2 {
    width: 40%;
    height: 80%;
    backdrop-filter: blur(4px);
    border-color: rgba(255,255,255,0.2);
    transform: rotate(-10deg);
  }

  /* Solar Plant Digital Twin Visual */
  .solar-visual {
    position: relative;
    width: 100%;
    height: 100%;
    background: #0d0f12;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .solar-grid-scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-image: 
      radial-gradient(ellipse at 50% 50%, rgba(199, 255, 74, 0.06), transparent 70%),
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 100% 100%, 30px 30px, 30px 30px;
  }

  .solar-topology {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 70%;
    max-width: 380px;
    transform: perspective(600px) rotateX(25deg);
    transform-style: preserve-3d;
  }

  .solar-row {
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.03), rgba(199, 255, 74, 0.05), rgba(255, 255, 255, 0.03));
    border-radius: 2px;
  }

  .solar-array-highlight {
    margin-top: 0.5rem;
    padding: 0.6rem 1rem;
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid var(--color-accent);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 3px;
    box-shadow: 0 0 20px rgba(199, 255, 74, 0.15);
  }

  .pulse-marker {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
    animation: pulse-dot 1.8s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  .array-id {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text-primary);
  }

  /* AR Visual */
  .ar-visual {
    position: relative;
    width: 100%;
    height: 100%;
    background: #080808;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ar-reticle-scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ar-bounding-box {
    width: 60%;
    height: 60%;
    position: relative;
    border: 1px dashed rgba(255, 255, 255, 0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-accent);
  }
  .c-tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .c-tr { top: -2px; right: -2px; border-left: none; border-bottom: none; }
  .c-bl { bottom: -2px; left: -2px; border-right: none; border-top: none; }
  .c-br { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  .ar-crosshair {
    width: 32px;
    height: 32px;
    border: 1px solid rgba(199, 255, 74, 0.6);
    border-radius: 50%;
    position: relative;
  }

  .ar-crosshair::before,
  .ar-crosshair::after {
    content: '';
    position: absolute;
    background: var(--color-accent);
  }

  .ar-crosshair::before {
    top: 50%;
    left: -6px;
    right: -6px;
    height: 1px;
    transform: translateY(-50%);
  }

  .ar-crosshair::after {
    left: 50%;
    top: -6px;
    bottom: -6px;
    width: 1px;
    transform: translateX(-50%);
  }

  .ar-status-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .asset-dev-label {
    position: absolute;
    bottom: 1.5rem;
    padding: 0.35rem 0.75rem;
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.6);
    border-radius: 2px;
    text-transform: uppercase;
    pointer-events: none;
  }

  .placeholder-visual {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
  }

  .placeholder-text {
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.3);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .project-content {
      grid-template-columns: 1fr;
      grid-template-rows: auto 50vh;
      gap: 2rem;
    }
    
    .project-info {
      justify-content: flex-start;
    }
  }

  @media (max-width: 768px) {
    .work-project {
      width: 86vw;
      max-width: 400px;
      height: min(78vh, 620px);
      margin: 0 auto;
      opacity: 0.5; /* Let GSAP active state bring it to 1 */
      margin-bottom: 0;
      transform: scale(0.96);
    }
    
    .project-content {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
      width: 100%;
      box-sizing: border-box;
      padding: 1.15rem 1.15rem 1rem 1.15rem;
      background: rgba(14, 18, 24, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      gap: 0.75rem;
      overflow: hidden;
    }

    /* Place visual at the top of the mobile card */
    .project-visual-container {
      order: -1;
      width: 100%;
      flex: 1 1 auto;
      min-height: 160px;
      max-height: 240px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .project-visual {
      width: 100%;
      height: 100%;
      border-radius: 6px;
      background: #06090e;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .project-image {
      object-fit: contain;
      object-position: center;
      width: 100%;
      height: 100%;
    }

    .project-info {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.4rem;
      flex-shrink: 0;
    }

    .project-header {
      gap: 0.5rem;
      margin-bottom: 0.1rem;
    }

    .project-number {
      font-size: 1.1rem;
    }

    .project-org {
      font-size: 0.8rem;
    }

    .hero-badge {
      font-size: 0.6rem;
      padding: 0.15rem 0.45rem;
    }

    .project-title {
      font-size: clamp(1.25rem, 5vw, 1.55rem);
      line-height: 1.15;
      margin: 0;
      letter-spacing: -0.01em;
    }

    .project-category {
      font-size: 0.7rem;
      margin-top: 0;
      letter-spacing: 0.08em;
    }

    .project-details {
      margin-top: 0.25rem;
      gap: 0.4rem;
    }

    .project-description {
      font-size: 0.825rem;
      line-height: 1.35;
      color: rgba(255, 255, 255, 0.75);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0;
    }

    .detail-group {
      font-size: 0.75rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tech-list {
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .confidentiality-note {
      display: none;
    }

    .project-link {
      margin-top: 0.4rem;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      opacity: 1;
      transform: none;
      padding-bottom: 0.15rem;
      align-self: flex-start;
    }

    .project-content:hover .project-visual,
    .project-content:hover .project-video,
    .project-content:hover .project-image,
    .project-content:hover .abstract-visual {
      transform: none;
    }

    /* Abstract visuals responsive scaling */
    .solar-topology {
      width: 85%;
      gap: 0.75rem;
      transform: perspective(500px) rotateX(20deg);
    }

    .solar-row {
      height: 24px;
    }

    .solar-array-highlight {
      padding: 0.4rem 0.75rem;
    }

    .ar-bounding-box {
      width: 75%;
      height: 75%;
      gap: 0.5rem;
    }
  }
</style>
