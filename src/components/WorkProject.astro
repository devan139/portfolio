---
// src/components/WorkProject.astro
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const formattedIndex = String(index + 1).padStart(2, '0');
---

<div class="work-project" data-index={index + 1}>
  <div class="project-content" data-cursor="VIEW">
    <div class="project-visual">
      {project.image ? (
        <img src={project.image} alt={project.title} class="project-image" loading="lazy" />
      ) : (
        <div class="placeholder-visual">
          <span class="placeholder-text">VISUAL ASSET</span>
        </div>
      )}
    </div>
    
    <div class="project-info">
      <div class="project-header">
        <span class="project-number">{formattedIndex}</span>
        <h3 class="project-title">{project.title}</h3>
      </div>
      <p class="project-description">{project.description}</p>
      <div class="project-meta">
        <span class="project-type">{project.type}</span>
      </div>
      
      <a href={`#`} class="project-link" aria-label={`View ${project.title} details`}>
        ENTER EXPERIENCE &rarr;
      </a>
    </div>
  </div>
</div>

<style>
  .work-project {
    width: 60vw;
    height: 70vh;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
    opacity: 0.5; /* Default state for inactive projects */
    transform: scale(0.9);
  }

  /* Active state managed by JS/ScrollTrigger */
  .work-project.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .project-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    cursor: pointer;
  }

  .project-visual {
    flex: 1;
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .placeholder-visual {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0.05) 100%);
  }

  .placeholder-text {
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: 0.2em;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .project-content:hover .project-image {
    transform: scale(1.05);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-content:hover .project-info {
    transform: translateY(-10px);
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .project-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 300;
  }

  .project-title {
    font-size: 3rem;
    font-weight: 500;
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
  }

  .project-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 80%;
    margin: 0;
  }

  .project-meta {
    margin-top: 0.5rem;
  }

  .project-type {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 100px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.8);
  }

  .project-link {
    margin-top: 1rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--primary-color);
    display: inline-flex;
    align-items: center;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .project-content:hover .project-link {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .work-project {
      width: 100%;
      height: auto;
      opacity: 1;
      transform: none;
      margin-bottom: 4rem;
    }
    
    .project-visual {
      aspect-ratio: 4/3;
      height: auto;
    }

    .project-content:hover .project-info {
      transform: none;
    }

    .project-content:hover .project-image {
      transform: none;
    }

    .project-link {
      opacity: 1;
      transform: none;
    }

    .project-title {
      font-size: 2rem;
    }
    
    .project-description {
      font-size: 1rem;
      max-width: 100%;
    }
  }
</style>
