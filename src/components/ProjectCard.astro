---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---
<div class="project-card group">
  <div class="project-visual">
    {project.video ? (
      <video src={project.video} muted loop playsinline class="media" />
    ) : project.image ? (
      <img src={project.image} alt={project.title} class="media" />
    ) : (
      <div class="placeholder-media"></div>
    )}
    
    {project.status === 'building' && (
      <div class="status-badge">CURRENTLY BUILDING</div>
    )}
  </div>
  
  <div class="project-info">
    <h3>{project.title}</h3>
    <p class="type">{project.type}</p>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    cursor: pointer;
  }

  .project-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #1A1A1A;
    border-radius: 4px;
  }

  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .placeholder-media {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, #1A1A1A, #2A2A2A);
  }

  .project-card:hover .media {
    transform: scale(1.05);
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: var(--color-accent);
    color: var(--color-bg);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: 20px;
    text-transform: uppercase;
  }

  .project-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .type {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }
</style>

<script>
  // Setup play on hover for videos if needed later
  const cards = document.querySelectorAll('.project-card');
  cards.forEach(card => {
    const video = card.querySelector('video');
    if (video) {
      card.addEventListener('mouseenter', () => video.play().catch(()=>{}));
      card.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    }
  });
</script>
