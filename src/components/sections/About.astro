---
import SectionHeading from '../SectionHeading.astro';
---
<section id="about" class="section">
  <div class="container">
    <SectionHeading title="About" subtitle="Who I Am" />
    
    <div class="about-content">
      <p class="lead">
        I am an XR Engineer and Product Builder focused on creating immersive experiences, simulations, and products at the intersection of XR, software, and product thinking.
      </p>
      <div class="about-details">
        <p>
          More details about my background, approach, and philosophy will go here.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 8rem 5%;
    background-color: #0F0F0F;
  }

  .container {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .about-content {
    max-width: 800px;
  }

  .lead {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.3;
    margin-bottom: 2rem;
    font-family: var(--font-heading);
  }

  .about-details {
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }
</style>
