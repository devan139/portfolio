---
import { background, education, currentlyExploring } from '../../data/experience';
---

<section id="about" class="about-section" aria-labelledby="about-heading">
  <div class="about-container">
    
    <div class="about-header gs-reveal-about">
      <span class="section-label">ABOUT</span>
    </div>

    <div class="about-main-content">
      <div class="about-statement gs-reveal-about">
        <h2 id="about-heading" class="statement-title">
          I BUILD WORLDS.<br/>
          THEN I STARTED BUILDING<br/>
          THE SYSTEMS AROUND THEM.
        </h2>
      </div>
      
      <div class="about-story gs-reveal-about">
        <p>
          I'm an XR Engineer and Product Builder focused on creating immersive experiences, simulations and software products.
        </p>
        <p>
          My background is rooted in Unity, 3D interaction and VR. Building real-world immersive experiences led me to become increasingly interested in the systems behind them &mdash; how people interact with products, how ideas become usable experiences, and how technology can solve meaningful problems.
        </p>
        <p>
          Today, I work across XR, software, AI and product thinking &mdash; moving from idea to prototype to something people can actually use.
        </p>
      </div>
    </div>

    <div class="about-bottom-content">
      <div class="about-background gs-reveal-about">
        <span class="small-label">BACKGROUND</span>
        <ul class="timeline-list">
          {background.map(item => (
            <li class="timeline-item">
              <span class="timeline-period">{item.period || ''}</span>
              <div class="timeline-details">
                <span class="timeline-company">{item.company}</span>
                <span class="timeline-role">{item.role}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="about-secondary">
        <div class="about-education gs-reveal-about">
          <span class="small-label">EDUCATION</span>
          <div class="education-details">
            <span class="edu-degree">{education.degree}</span>
            <span class="edu-major">&mdash; {education.major}</span>
          </div>
        </div>

        <div class="about-exploring gs-reveal-about">
          <span class="small-label">CURRENTLY EXPLORING</span>
          <ul class="exploring-list">
            {currentlyExploring.map(item => (
              <li class="explore-item">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (typeof window !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const section = document.getElementById('about');

    if (section && !prefersReducedMotion) {
      gsap.set('.gs-reveal-about', { opacity: 0, y: 30 });

      ScrollTrigger.create({
        trigger: section,
        start: 'top 70%',
        onEnter: () => {
          gsap.to('.gs-reveal-about', {
            opacity: 1,
            y: 0,
            duration: 1,
            stagger: 0.15,
            ease: 'power3.out'
          });
        },
        once: true
      });
    } else if (prefersReducedMotion) {
      gsap.set('.gs-reveal-about', { opacity: 1, y: 0 });
    }
  }
</script>

<style>
  .about-section {
    /* Huge top padding for breathing room from I BUILD WITH */
    padding: 12rem 5% 10rem 5%;
    background-color: var(--background-color, #0A0A0A);
    color: var(--text-color, #F2F0EA);
  }

  .about-container {
    max-width: var(--container-width, 1200px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  /* Labels */
  .section-label, .small-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    color: var(--color-text-muted, #858585);
    text-transform: uppercase;
  }

  .small-label {
    display: block;
    margin-bottom: 2rem;
  }

  /* Main Layout */
  .about-main-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
    align-items: end;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 6rem;
  }

  .statement-title {
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .about-story {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-story p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  /* Bottom Content Layout */
  .about-bottom-content {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
    padding-top: 2rem;
  }

  /* Timeline */
  .timeline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    align-items: baseline;
  }

  .timeline-period {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.05em;
  }

  .timeline-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .timeline-company {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.125rem;
    letter-spacing: 0.1em;
    color: var(--text-color);
  }

  .timeline-role {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  /* Secondary Items */
  .about-secondary {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .education-details {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.125rem;
  }

  .edu-degree {
    color: var(--text-color);
  }

  .edu-major {
    color: var(--color-text-muted);
  }

  /* Exploring */
  .exploring-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .explore-item {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.125rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    transition: color 0.3s ease, transform 0.3s ease;
    cursor: default;
    display: inline-block;
    width: fit-content;
  }

  .explore-item:hover {
    color: var(--color-accent);
    transform: translateX(8px);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .about-main-content,
    .about-bottom-content {
      gap: 3rem;
      grid-template-columns: 1fr;
      align-items: start;
    }

    .about-statement {
      max-width: 90%;
    }

    .about-story {
      max-width: 80%;
    }
  }

  @media (max-width: 768px) {
    .about-section {
      padding: 8rem 5%;
    }

    .about-story {
      max-width: 100%;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .timeline-period {
      font-size: 0.875rem;
      margin-bottom: 0.25rem;
    }
  }

  /* Reduced Motion Override */
  @media (prefers-reduced-motion: reduce) {
    .explore-item {
      transition: none !important;
    }
    
    .explore-item:hover {
      transform: none !important;
    }
  }
</style>
