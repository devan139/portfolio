---
import SectionHeading from '../SectionHeading.astro';
import MacFolderGallery from '../MacFolderGallery.astro';
import { featuredProjects } from '../../data/projects';
---

<div id="work"></div>
<section id="work-section" class="selected-work-section" aria-label="Selected XR Engineering Projects">
  <div class="section-container">
    <SectionHeading 
      title="SELECTED PROJECTS" 
      subtitle="SYSTEM DIRECTORY · XR EXPERIENCES" 
    />
    <MacFolderGallery projects={featuredProjects} />
  </div>
</section>

<style>
  .selected-work-section {
    position: relative;
    width: 100%;
    background-color: var(--background-color, #0a0a0a);
    color: var(--text-color, #ffffff);
    padding: 6rem 5% 4rem 5%;
    overflow: hidden;
  }

  .section-container {
    max-width: var(--container-width, 1400px);
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .selected-work-section {
      padding: 4rem 4% 3rem 4%;
    }
  }
</style>
