---
import { socials } from '../../data/socials';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    
    <div class="footer-brand">
      <span class="footer-name">DEVANARAYANAN</span>
      <span class="footer-role">XR ENGINEER &middot; PRODUCT BUILDER</span>
      <span class="footer-copy">&copy; {currentYear} DEVANARAYANAN</span>
    </div>

    <div class="footer-actions">
      <ul class="footer-socials">
        {socials.map(s => (
          <li>
            <a 
              href={s.url} 
              target={s.isEmail ? undefined : "_blank"} 
              rel={s.isEmail ? undefined : "noopener noreferrer"}
              class="footer-link"
            >
              {s.name}
            </a>
          </li>
        ))}
      </ul>
      
      <button class="back-to-top" id="back-to-top" aria-label="Scroll to top">
        BACK TO TOP &uarr;
      </button>
    </div>

  </div>
</footer>

<script>
  if (typeof window !== 'undefined') {
    const backToTopBtn = document.getElementById('back-to-top');
    
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        window.scrollTo({
          top: 0,
          behavior: prefersReducedMotion ? 'auto' : 'smooth'
        });
      });
    }
  }
</script>

<style>
  .site-footer {
    padding: 4rem 5%;
    background-color: var(--background-color, #0A0A0A);
    color: var(--color-text-muted, #858585);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-container {
    max-width: var(--container-width, 1200px);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 4rem;
  }

  /* Brand Info */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--text-color, #F2F0EA);
  }

  .footer-role {
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .footer-copy {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  /* Actions */
  .footer-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2rem;
  }

  .footer-socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.5rem;
  }

  .footer-link,
  .back-to-top {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible,
  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: var(--color-accent, #C7FF4A);
    outline: none;
  }

  .back-to-top {
    text-transform: uppercase;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 3rem;
    }

    .footer-actions {
      align-items: flex-start;
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .footer-socials {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
